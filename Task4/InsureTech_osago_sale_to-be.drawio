        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-69" edge="1" parent="6CIlCLdzkCVqK3ZIDFRR-45" source="6CIlCLdzkCVqK3ZIDFRR-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=11;" target="6CIlCLdzkCVqK3ZIDFRR-54" value="обновляет локальные реплики&lt;br&gt;и реестры взаиморасчётов">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-70" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;API ОСАГО&lt;/b&gt;&lt;br&gt;Веб-приложение → core-app: POST /api/osago/applications, Rate Limited&lt;br&gt;core-app → Веб-приложение: WebSocket /ws/osago/offers/{applicationId}&lt;br&gt;core-app → osago-aggregator: открыть gRPC server stream CreateOsagoQuote&lt;br&gt;osago-aggregator → core-app: offer_update / insurer_error / completed" vertex="1">
          <mxGeometry height="150" width="540" x="2004.8333333333335" y="613.8055555555554" as="geometry" />
        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-71" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Паттерны надёжности ОСАГО&lt;/b&gt;&lt;br&gt;Rate Limiting: inbound для POST/WebSocket handshake + outbound-квота по каждой СК&lt;br&gt;Timeout: общий deadline 60с на quote session + timeout create/poll по каждой СК&lt;br&gt;Retry: ограниченные retry только для временных REST-ошибок, внутри 60с&lt;br&gt;Circuit Breaker: изолированно по каждой СК&lt;br&gt;Bulkhead: отдельные worker / connection pools по каждой СК" vertex="1">
          <mxGeometry height="185" width="540" x="2614.8333333333335" y="613.8055555555554" as="geometry" />
        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-72" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Несколько реплик&lt;/b&gt;&lt;br&gt;пик: до 2,5 тыс. активных quote sessions&lt;br&gt;osago-db хранит состояние polling; работа распределяется по quoteSessionId&lt;br&gt;идемпотентность по requestId / quoteSessionId&lt;br&gt;WebSocket-соединение остаётся на реплике core-app, открывшей gRPC-stream&lt;br&gt;реплики osago-aggregator возобновляют polling из сохранённого состояния" vertex="1">
          <mxGeometry height="170" width="520" x="3224.8333333333335" y="613.8055555555554" as="geometry" />
        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-73" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Каталог и полисы&lt;/b&gt;&lt;br&gt;Каталог продуктов и события полисов остаются в Kafka с Transactional Outbox. insurance_policy_issued содержит settlement data. Ответы по ОСАГО не публикуются в Kafka; они идут по gRPC-stream в core-app." vertex="1">
          <mxGeometry height="145" width="280" x="1674.8333333333335" y="613.8055555555554" as="geometry" />
        </mxCell>
        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-74" edge="1" parent="1" source="6CIlCLdzkCVqK3ZIDFRR-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=11;" target="6CIlCLdzkCVqK3ZIDFRR-43" value="использует">
