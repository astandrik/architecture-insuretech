        <mxCell id="6CIlCLdzkCVqK3ZIDFRR-68" edge="1" parent="6CIlCLdzkCVqK3ZIDFRR-45" source="6CIlCLdzkCVqK3ZIDFRR-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=11;" target="6CIlCLdzkCVqK3ZIDFRR-53" value="consume product-catalog-events&lt;br&gt;consume policy-events&lt;br&gt;строит локальную реплику полисов">
