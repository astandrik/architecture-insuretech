        <mxCell id="NEB-Y5XdSD5AEIW8j8R5-367" edge="1" parent="NEB-Y5XdSD5AEIW8j8R5-344" source="NEB-Y5XdSD5AEIW8j8R5-352" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=11;" target="NEB-Y5XdSD5AEIW8j8R5-353" value="обновляет локальные реплики&lt;br&gt;и реестры взаиморасчётов">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="NEB-Y5XdSD5AEIW8j8R5-368" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;API ОСАГО&lt;/b&gt;&lt;br&gt;Веб-приложение → core-app: POST /api/osago/applications&lt;br&gt;core-app → Веб-приложение: WebSocket /ws/osago/offers/{applicationId}&lt;br&gt;core-app → osago-aggregator: gRPC server stream CreateOsagoQuote&lt;br&gt;stream-сообщения: offer_update / insurer_error / completed" vertex="1">
          <mxGeometry height="150" width="540" x="1137.3333333333335" y="1065.5555555555554" as="geometry" />
        </mxCell>
        <mxCell id="NEB-Y5XdSD5AEIW8j8R5-369" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Паттерны надёжности на outbound ОСАГО&lt;/b&gt;&lt;br&gt;Timeout: общий deadline 60с на quote session + timeout create/poll по каждой СК&lt;br&gt;Retry: ограниченные retry только для временных REST-ошибок, внутри 60с&lt;br&gt;Circuit Breaker: изолированно по каждой СК&lt;br&gt;Rate Limiting: outbound-квота по каждой СК&lt;br&gt;Bulkhead: отдельные worker / connection pools по каждой СК" vertex="1">
          <mxGeometry height="170" width="540" x="1747.3333333333335" y="1065.5555555555554" as="geometry" />
        </mxCell>
        <mxCell id="NEB-Y5XdSD5AEIW8j8R5-370" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Несколько реплик&lt;/b&gt;&lt;br&gt;osago-db хранит состояние polling; работа распределяется по quoteSessionId&lt;br&gt;идемпотентность по requestId / quoteSessionId&lt;br&gt;WebSocket-соединение остаётся на реплике core-app, открывшей gRPC-stream&lt;br&gt;реплики osago-aggregator возобновляют polling из сохранённого состояния" vertex="1">
          <mxGeometry height="150" width="520" x="2357.3333333333335" y="1065.5555555555554" as="geometry" />
        </mxCell>
        <mxCell id="NEB-Y5XdSD5AEIW8j8R5-371" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" value="&lt;b&gt;Каталог и полисы&lt;/b&gt;&lt;br&gt;Каталог продуктов и события полисов остаются в Kafka с Transactional Outbox. Ответы по ОСАГО не публикуются в Kafka; они идут по gRPC-stream в core-app." vertex="1">
          <mxGeometry height="145" width="280" x="807.3333333333335" y="1065.5555555555554" as="geometry" />
        </mxCell>
